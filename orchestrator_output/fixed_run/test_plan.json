    "name": "Nominal Below Threshold (25C)",
    "category": "nominal",
    "description": "Temperature at 25C (below 30C threshold). Fan should be OFF, Error OFF.",
    "inputs": {
      "temperature_c": 25.0,
      "adc": 512
    },
    "expected_output": {
      "fan_pin": 0,
      "err_pin": 0,
      "serial_contains": "TEMP=25 FAN=OFF STATE=NORMAL"
    }
